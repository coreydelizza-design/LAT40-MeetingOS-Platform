+
+/* ==========================================================================
+   Signal & Noise (Review stage)
+   A monochrome editorial rule. Segments differentiate by FILL DENSITY, never
+   hue — that is forced by the monochrome lock and is the accessible choice too.
+   ========================================================================== */
+
+.sn-lede {
+  font-family: var(--serif);
+  font-weight: 500;
+  font-size: 34px;
+  line-height: 1.16;
+  letter-spacing: -0.02em;
+  color: var(--ink);
+  max-width: 20ch;
+}
+.sn-lede .mark { border-bottom: 2px solid var(--ink); }
+.sn-sub {
+  margin-top: 14px;
+  font-size: 14px;
+  line-height: 1.55;
+  color: var(--smoke);
+  max-width: 64ch;
+}
+.sn-sub strong { color: var(--graphite); font-weight: 600; }
+
+/* Fill-density set — signal solid, then decreasing density to outline. */
+.sn-fill-solid  { background: var(--ink); }
+.sn-fill-dots   { background-image: radial-gradient(var(--ink) 1.15px, transparent 1.3px); background-size: 5px 5px; }
+.sn-fill-hatch  { background-image: repeating-linear-gradient(45deg, var(--ink) 0 1.4px, transparent 1.4px 5px); }
+.sn-fill-cross  { background-image: repeating-linear-gradient(45deg, var(--ink) 0 1.1px, transparent 1.1px 6px), repeating-linear-gradient(-45deg, var(--ink) 0 1.1px, transparent 1.1px 6px); }
+.sn-fill-sparse { background-image: repeating-linear-gradient(45deg, var(--ink) 0 1px, transparent 1px 9px); }
+.sn-fill-outline{ background: var(--white); }
+/* Irreducible floor — a lighter cross so it reads as "protected", not recoverable. */
+.sn-fill-irr    { background-image: repeating-linear-gradient(45deg, var(--line-strong) 0 1px, transparent 1px 6px), repeating-linear-gradient(-45deg, var(--line-strong) 0 1px, transparent 1px 6px); }
+
+.sn-bar-caps { display: flex; justify-content: space-between; margin: 34px 0 8px; }
+.sn-bar-caps span {
+  font-family: var(--mono);
